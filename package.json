{
  "name": "@local/dsh-metacog-task",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Metacognition for DSH: durable event storage, task boundaries, structured reflection, and three-scope memory injected into the system prompt.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "tools/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
